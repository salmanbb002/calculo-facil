{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.calculadorasonline.xyz" }],
      "destination": "https://calculadorasonline.xyz/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "www.calculadorasonline.xyz" }],
      "destination": "https://calculadorasonline.xyz/:path+",
      "permanent": true
    }
  ]
}
